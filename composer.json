{
    "name": "kechankrisna/php_payway",
    "description": "ABA PayWay Ecommerce Checkout client for PHP: purchase, check, close, refund and list transactions, exchange rates, and callback verification.",
    "type": "library",
    "license": "proprietary",
    "homepage": "https://github.com/kechankrisna/payway-checkout/tree/main/php",
    "authors": [
        {
            "name": "kechankrisna",
            "email": "ke.chankrisna168@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/kechankrisna/payway-checkout/issues",
        "source": "https://github.com/kechankrisna/payway-checkout"
    },
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "ext-openssl": "*",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^2.0 || ^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2",
        "phpunit/phpunit": "^12"
    },
    "autoload": {
        "psr-4": {
            "PhpPayway\\": "php/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpPayway\\Tests\\": "php/tests/"
        }
    },
    "scripts": {
        "test": "phpunit -c php/phpunit.xml.dist",
        "test:unit": "phpunit -c php/phpunit.xml.dist --exclude-group integration",
        "analyse": "phpstan analyse -c php/phpstan.neon --memory-limit=1G",
        "cs": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true
    },
    "keywords": [
        "aba",
        "payway",
        "cambodia",
        "payment",
        "checkout",
        "sdk"
    ],
    "suggest": {
        "ext-curl": "Needed by the built-in HTTP client, unless you pass a PSR-18 client"
    }
}
