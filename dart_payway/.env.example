# ABA PayWay checkout sandbox credentials, used by the integration tests.
# Copy to .env (never commit it) and fill in the values ABA gave you.
ABA_PAYWAY_API_URL="https://checkout-sandbox.payway.com.kh"
ABA_PAYWAY_MERCHANT_ID="provided by ABA"
ABA_PAYWAY_API_KEY="provided by ABA"
ABA_PAYWAY_REFERER_DOMAIN="your whitelisted domain, e.g. https://example.com"
# optional, needed for the refund API (PEM or bare base64)
ABA_PAYWAY_RSA_PUBLIC_KEY=""
